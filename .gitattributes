# Normalise line endings so files authored from Windows do not break WSL/CI shells.
* text=auto eol=lf

*.sh text eol=lf
*.bash text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.js text eol=lf
*.md text eol=lf
*.rs text eol=lf
*.toml text eol=lf
Dockerfile text eol=lf

*.bat text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.ico binary
*.webp binary
