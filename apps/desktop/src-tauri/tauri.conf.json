{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sina Maoni",
  "version": "0.1.0",
  "identifier": "com.sinamaoni.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev:web",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Sina Maoni",
        "width": 1200,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:3001"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
